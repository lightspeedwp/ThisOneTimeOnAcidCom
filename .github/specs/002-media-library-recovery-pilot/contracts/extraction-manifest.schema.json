{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Figma Asset Extraction Manifest",
  "description": "Schema for extraction-manifest.json produced by T012 extraction script. Validates per-asset extraction outcomes and metadata.",
  "type": "object",
  "required": [
    "extraction_date",
    "total_assets",
    "success",
    "fallback",
    "failed",
    "assets"
  ],
  "properties": {
    "extraction_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of extraction run start"
    },
    "total_assets": {
      "type": "integer",
      "minimum": 1,
      "description": "Total assets attempted in extraction"
    },
    "success": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of recovered assets (status='recovered')"
    },
    "fallback": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of fallback assets (status='fallback')"
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of failed assets (status='failed')"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "description": "Per-asset extraction records",
      "items": {
        "type": "object",
        "required": [
          "catalogueId",
          "figmaAssetId",
          "originalFilename",
          "category",
          "recoveryStatus",
          "exportedPath",
          "fileSize",
          "dimensions",
          "extractionTime_ms",
          "timestamp",
          "notes"
        ],
        "properties": {
          "catalogueId": {
            "type": "string",
            "description": "Cross-reference to FULL-CATALOGUE.json assetId (e.g., 'toa-asset-001')"
          },
          "figmaAssetId": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "description": "40-character Figma node hash"
          },
          "originalFilename": {
            "type": "string",
            "description": "Asset filename (e.g., 'heroImage1.png')"
          },
          "category": {
            "type": "string",
            "description": "Asset category (e.g., 'hero', 'portfolio/jungle-festival', 'unmapped')"
          },
          "recoveryStatus": {
            "type": "string",
            "enum": ["recovered", "fallback", "failed"],
            "description": "Extraction outcome: recovered (direct Figma), fallback (Unsplash), failed (no recovery)"
          },
          "exportedPath": {
            "oneOf": [
              {
                "type": "string",
                "description": "File path relative to project root (e.g., 'recovered-assets/hero/heroImage1.png'). Only for recovered assets."
              },
              {
                "type": "null",
                "description": "null for fallback or failed assets"
              }
            ]
          },
          "fallbackSource": {
            "oneOf": [
              {
                "type": "string",
                "description": "Unsplash image ID for fallback (e.g., 'unsplash:portfolio-jungle-1'). Only for fallback assets."
              },
              {
                "type": "null",
                "description": "null for recovered or failed assets"
              }
            ]
          },
          "fileSize": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes. 0 for fallback/failed assets."
          },
          "dimensions": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "description": "Image width in pixels"
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "description": "Image height in pixels"
              }
            }
          },
          "extractionTime_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Wall-clock extraction time in milliseconds. 0 for fallback/failed."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 completion timestamp for this asset"
          },
          "notes": {
            "type": "string",
            "description": "Error message, recovery decision, or empty string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "extraction_date": "2026-10-18T14:32:00Z",
      "total_assets": 2,
      "success": 1,
      "fallback": 1,
      "failed": 0,
      "assets": [
        {
          "catalogueId": "toa-asset-001",
          "figmaAssetId": "f4a28f747d49fc9d37311b17f513b62e2b95a73e",
          "originalFilename": "heroImage1.png",
          "category": "hero",
          "recoveryStatus": "recovered",
          "exportedPath": "recovered-assets/hero/heroImage1.png",
          "fallbackSource": null,
          "fileSize": 234567,
          "dimensions": {
            "width": 1200,
            "height": 900
          },
          "extractionTime_ms": 2345,
          "timestamp": "2026-10-18T14:34:56Z",
          "notes": ""
        },
        {
          "catalogueId": "toa-asset-042",
          "figmaAssetId": "378acbf4a7518ca6c40b44540bd7a121a91375fe",
          "originalFilename": "jungleImage1.png",
          "category": "portfolio/jungle-festival",
          "recoveryStatus": "fallback",
          "exportedPath": null,
          "fallbackSource": "unsplash:portfolio-jungle-1",
          "fileSize": 0,
          "dimensions": {
            "width": 1024,
            "height": 768
          },
          "extractionTime_ms": 0,
          "timestamp": "2026-10-18T14:35:12Z",
          "notes": "Asset not found in Make project after 4 API retries; Unsplash fallback applied"
        }
      ]
    }
  ]
}
