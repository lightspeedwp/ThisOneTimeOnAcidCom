{
  "model": "claude-sonnet-5-5",
  "tools": {
    "enable_bash": true,
    "enable_file_operations": true,
    "enable_git": true,
    "enable_agents": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude/validate.sh",
            "timeout": 60,
            "match_output": true
          },
          {
            "type": "command",
            "command": "node scripts/validate-branch-name.js",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "agents": {
    "enabled": true,
    "defaults": {
      "model": "claude-sonnet-5-5",
      "reasoning_effort": "medium"
    }
  },
  "notes": "Shared repository settings. Do NOT commit credentials or personal paths. Use .claude/settings.local.json for machine-specific overrides."
}
