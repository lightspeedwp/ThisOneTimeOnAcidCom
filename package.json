{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "journal:parse": "tsx scripts/parse-journal-markdown.ts",
    "journal:validate": "tsx scripts/parse-journal-markdown.ts --validate-only",
    "journal:check-links": "tsx scripts/check-journal-links.ts",
    "test": "npm run test:unit && npm run test:native && npm run test:build && npm run test:e2e",
    "test:unit": "jest",
    "test:native": "node --test tests/sentry.test.mjs tests/source-maps.test.mjs",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:build": "npm run build && bats tests/build.bats",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "validate:branch-name": "node scripts/validate-branch-name.js",
    "validate:push-branch": "node scripts/validate-push-branch.js",
    "postinstall": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install"
  },
