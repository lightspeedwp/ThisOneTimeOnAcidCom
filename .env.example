# Figma API Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Figma Personal Access Token (from https://www.figma.com/developers/api#auth)
# This token is used to authenticate all API requests to Figma
FIGMA_API_TOKEN=your_figma_personal_access_token_here

# Figma Make Project File Key
# The project file key identifies the Figma file containing all 56 assets
# Extract from Figma URL: figma.com/file/{FILE_KEY}/...
FIGMA_MAKE_FILE_KEY=your_figma_make_project_file_key_here

# Optional: Figma Team ID (for team files)
# If assets are stored in a team file, provide the team ID
FIGMA_TEAM_ID=your_figma_team_id_here

# Asset Export Configuration
FIGMA_EXPORT_FORMAT=png
FIGMA_EXPORT_SCALE=2
FIGMA_EXPORT_QUALITY=high

# API Rate Limiting
# Figma API rate limit: 10-20 requests per minute per endpoint/seat (depends on plan tier)
# For starter/professional plans, use 10; for enterprise, may be up to 20
# With 5 concurrent requests, use a shared limiter that enforces FIGMA_API_RATE_LIMIT_PER_MINUTE across all requests and honours Retry-After; 50ms batching alone is not rate limiting
FIGMA_API_RATE_LIMIT_PER_MINUTE=10
FIGMA_CONCURRENT_REQUESTS=5

# Sentry (error monitoring)
# Public DSN — safe to expose client-side. Org: lightspeedwp, project: thisonetimeonacid.
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o4508112245817344.ingest.de.sentry.io/4512302760853584

# Sentry build-time config (source map upload via @sentry/vite-plugin in vite.config.ts).
# SENTRY_AUTH_TOKEN is a secret: create an organization auth token in Sentry
# (Organization Settings -> Auth Tokens) and set it in CI/Netlify env vars only —
# never commit it. Without it, the build still succeeds but skips source map upload.
SENTRY_ORG=lightspeedwp
SENTRY_PROJECT=thisonetimeonacid
SENTRY_AUTH_TOKEN=your_sentry_organization_auth_token_here
